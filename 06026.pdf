/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 71 /G put
dup 80 /P put
dup 81 /Q put
dup 83 /S put
dup 84 /T put
dup 106 /bar put
dup 121 /dagger put
dup 50 /element put
dup 0 /minus put
dup 2 /multiply put
dup 14 /openbullet put
dup 6 /plusminus put
dup 24 /similar put
readonly def
currentdict end
