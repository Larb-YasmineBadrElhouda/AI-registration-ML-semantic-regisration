dup 94 /circumflex put
dup 58 /colon put
dup 56 /eight put
dup 61 /equal put
dup 53 /five put
dup 52 /four put
dup 57 /nine put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 37 /percent put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 126 /tilde put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
